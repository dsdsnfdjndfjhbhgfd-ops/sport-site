# База PostgreSQL (Supabase). Для сайта — пулер в режиме транзакций (порт 6543),
# для prisma db push — тот же хост, порт 5432.
DATABASE_URL="postgresql://prisma.PROJECT_REF:PASSWORD@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://prisma.PROJECT_REF:PASSWORD@aws-1-eu-central-1.pooler.supabase.com:5432/postgres"
# Секрет для подписи сессий (любая длинная случайная строка)
AUTH_SECRET="change-me-to-a-long-random-string"
# Адрес сайта (нужен для возврата после оплаты). На Vercel можно не задавать.
APP_URL="http://localhost:3000"

# Платёжный провайдер: mock | stripe | yookassa
PAYMENT_PROVIDER="mock"

# Stripe (тестовые ключи sk_test_...)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ЮKassa (тестовый магазин)
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""

# Первый администратор (создаётся при npm run db:seed)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="admin12345"
