DATABASE_URL="file:./dev.db"
# Секрет для подписи сессий (любая длинная случайная строка)
AUTH_SECRET="change-me-to-a-long-random-string"
# Адрес сайта (нужен для возврата после оплаты)
APP_URL="http://localhost:3000"

# Платёжный провайдер: mock | stripe | yookassa
PAYMENT_PROVIDER="mock"

# Stripe (тестовые ключи sk_test_...)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ЮKassa (тестовый магазин)
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""

# Первый администратор (создаётся при npm run db:seed)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="admin12345"
